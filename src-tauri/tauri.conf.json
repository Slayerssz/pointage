{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointage",
  "version": "1.0.0",
  "identifier": "ma.groupetriplea.pointage",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "windows": [
      {
        "title": "Pointage — Groupe Triple A",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["par-defaut"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Groupe Triple A",
    "category": "Business",
    "shortDescription": "Pointage du personnel",
    "longDescription": "Pointage du personnel, contrats, congés et paie — Groupe Triple A."
  }
}
